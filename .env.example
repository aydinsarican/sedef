# ~/.sedef/.env — secrets and host settings for the Sedef foreman. chmod 600.
# The foreman loads this file; agents never read it (policy-protected). Values here
# reach agent sessions only when a stage lists them under `secrets:` in pipeline.yaml,
# or only the MCP server config (headers) — never the agent's shell.

# ── Anthropic ──────────────────────────────────────────────────────────────
# Default auth.mode is "keychain": ./install.sh --set-api-key stores the key there.
# For auth.mode "env", set ANTHROPIC_API_KEY instead. For "oauth", CLAUDE_CODE_OAUTH_TOKEN.
# Use a dedicated Console workspace with its own monthly spend limit for the factory —
# not the personal/shared claude.ai account.
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# ── Telegram (idea gate, chores, daily digest, kill switch) ────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Your numeric Telegram user id(s), comma-separated. Required if TELEGRAM_CHAT_ID is a group;
# without it only the private chat with that id may command the factory.
TELEGRAM_ALLOWED_USER_IDS=

# ── Apple ──────────────────────────────────────────────────────────────────
# asc keeps its API key in the keychain (asc auth login). These are plain settings:
APPLE_TEAM_ID=
ASC_VENDOR_NUMBER=

# ── Google Play / Expo ─────────────────────────────────────────────────────
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=$HOME/.sedef/secrets/play-service-account.json
EXPO_TOKEN=

# ── Web / extensions ───────────────────────────────────────────────────────
# The release stage also deploys each product's legal site (privacy/support pages) with one of these.
# Scope tokens narrowly: one Vercel team / one Cloudflare account, Pages + Workers edit only.
VERCEL_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Chrome Web Store API v2 (OAuth client + refresh token; publisher id: Developer Dashboard → Account)
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
CWS_PUBLISHER_ID=

# ── Payments (web / Mac lanes) ─────────────────────────────────────────────
PADDLE_API_KEY=
POLAR_ACCESS_TOKEN=

# ── MCP servers (a stage skips a server whose key is missing) ──────────────
REVENUECAT_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=
STITCH_API_KEY=
REFERO_TOKEN=
APIFY_TOKEN=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# ── Cross-vendor critic (config: critic.enabled/provider/model) ────────────
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Host ───────────────────────────────────────────────────────────────────
JAVA_HOME=/opt/homebrew/opt/openjdk@17
